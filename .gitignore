# Environment secrets. Keep the sanitized template tracked.
.env
.env.*
!.env.example

# Node.js dependencies and package-manager state
node_modules/
.pnp.*
.yarn/install-state.gz

# Next.js and deployment build output
.next/
out/
build/
.vercel/
.netlify/
.turbo/

# Test and coverage output
coverage/
playwright-report/
test-results/

# Supabase local CLI state and generated database types
supabase/.temp/

# Spec Kit machine-local state. The source-of-truth specs/ directory stays tracked.
.specify/feature.json
.specify/cache/
.specify/state/
.specify/tmp/

# Logs and diagnostic output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# TypeScript build state
*.tsbuildinfo

# Local IDE state. Do not ignore .kiro/steering/; project steering is source.
.vscode/
.idea/

# Operating-system metadata and temporary files
.DS_Store
._*
Thumbs.db
Desktop.ini
ehthumbs.db
.Spotlight-V100/
.Trashes/
*.tmp
*.temp
*.swp
*.swo
*~

# Private key material
*.pem
